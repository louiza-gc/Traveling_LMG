<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id ="@id/map"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Barre d'instructions -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📍 Appuyez longuement sur la carte pour sélectionner un lieu"
        android:padding="12dp"
        android:background="#2196F3"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:gravity="center"/>

    <!-- Fragment de la carte -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        tools:context=".TravelShare.Publication.ActivityLocationPicker" />

    <!-- Zone d'affichage de l'adresse sélectionnée -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:elevation="4dp"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 Lieu sélectionné :"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#666"/>

        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aucun lieu sélectionné"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            android:textColor="#333"/>

    </LinearLayout>

    <!-- Bouton de validation -->
    <Button
        android:id="@+id/btnValidate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="✅ VALIDER CE LIEU"
        android:backgroundTint="#2196F3"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"/>

</LinearLayout>