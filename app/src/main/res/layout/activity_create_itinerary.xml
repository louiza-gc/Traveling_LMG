<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F4F6F8">

    <EditText
        android:id="@+id/etItineraryName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nom du parcours"
        android:padding="12dp"
        android:background="@android:drawable/edit_text" />

    <EditText
        android:id="@+id/etItineraryDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Description (optionnelle)"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sélectionnez les lieux à inclure :"
        android:layout_marginTop="16dp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPlacesForItinerary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />

    <ProgressBar
        android:id="@+id/progressBarItinerary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnSaveItinerary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="Enregistrer le parcours"
        android:backgroundTint="#00A8A8"
        android:textColor="@android:color/white" />

</LinearLayout>