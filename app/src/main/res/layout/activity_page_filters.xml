<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:background="#F5F0EB">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Header Filtres + cloche notif -->
        <TextView
            android:id="@+id/tvFilterTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filtres"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <ImageButton
            android:id="@+id/btnNotifFilter"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_notifications"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Activer notifications du filtre"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- ── TYPE DE LIEU (CHECKBOXES) ── -->
        <TextView
            android:id="@+id/tvLabelType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Type de lieu (plusieurs choix)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnNotifFilter"
            android:layout_marginTop="20dp"/>

        <ScrollView
            android:id="@+id/scrollTypes"
            android:layout_width="0dp"
            android:layout_height="150dp"
            app:layout_constraintTop_toBottomOf="@id/tvLabelType"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:id="@+id/containerCheckboxes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </ScrollView>

        <!-- ── PLAGE DE DATES ── -->
        <TextView
            android:id="@+id/tvLabelDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Période"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scrollTypes"
            android:layout_marginTop="16dp"/>

        <LinearLayout
            android:id="@+id/layoutDateRange"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tvLabelDate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp">

            <!-- Date début -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_date_input">

                <TextView
                    android:id="@+id/tvStartDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Début"
                    android:textSize="14sp"/>

                <ImageView
                    android:id="@+id/ivStartCal"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_calendar"/>

            </LinearLayout>

            <!-- Date fin -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_date_input">

                <TextView
                    android:id="@+id/tvEndDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Fin"
                    android:textSize="14sp"/>

                <ImageView
                    android:id="@+id/ivEndCal"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_calendar"/>

            </LinearLayout>

        </LinearLayout>

        <!-- ── AUTEUR ── -->
        <TextView
            android:id="@+id/tvLabelAuteur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auteur"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutDateRange"
            android:layout_marginTop="16dp"/>

        <AutoCompleteTextView
            android:id="@+id/actvAuteur"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:hint="Sélectionner l'auteur"
            android:textSize="14sp"
            android:textColor="#1A1A1A"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvLabelAuteur"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>

        <!-- ── LIEU ── -->
        <TextView
            android:id="@+id/tvLabelLieu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lieu"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/actvAuteur"
            android:layout_marginTop="16dp"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutLieu"
            android:layout_width="0dp"
            android:layout_height="48dp"
            app:layout_constraintTop_toBottomOf="@id/tvLabelLieu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/etLieu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="Sélectionner le lieu"
                android:textSize="14sp"
                android:textColor="#1A1A1A"
                android:background="@android:color/transparent"
                android:paddingStart="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivLocIcon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <ImageView
                android:id="@+id/ivLocIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_location"
                android:contentDescription="Localisation"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginEnd="12dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ── RAYON ── -->
        <TextView
            android:id="@+id/tvLabelRayon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rayon"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutLieu"
            android:layout_marginTop="16dp"/>

        <AutoCompleteTextView
            android:id="@+id/actvRayon"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:hint="Sélectionner le rayon"
            android:textSize="14sp"
            android:textColor="#1A1A1A"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvLabelRayon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>

        <!-- ── BOUTONS Appliquer / Réinitialiser ── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyFilters"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="Appliquer"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1A1A1A"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/actvRayon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnResetFilters"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetFilters"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="Réinitialiser"
            android:textColor="#1A1A1A"
            app:strokeColor="#CCCCCC"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/actvRayon"
            app:layout_constraintStart_toEndOf="@id/btnApplyFilters"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp"
            android:layout_marginStart="8dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>