<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Signaler cette publication"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#D32F2F"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pourquoi signalez-vous ?"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="12dp"/>

    <RadioGroup
        android:id="@+id/radioGroupReport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">

        <RadioButton
            android:id="@+id/radioSpam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📢 Spam ou contenu trompeur"
            android:layout_marginBottom="12dp"/>

        <RadioButton
            android:id="@+id/radioInappropriate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚫 Contenu inapproprié"
            android:layout_marginBottom="12dp"/>

        <RadioButton
            android:id="@+id/radioHarassment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ Harcèlement ou discours haineux"/>

    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelReport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Annuler"
            android:background="@android:color/transparent"
            android:textColor="#666666"/>

        <Button
            android:id="@+id/btnSubmitReport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Signaler"
            android:textColor="#D32F2F"
            android:background="@android:color/transparent"/>

    </LinearLayout>

</LinearLayout>