<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F0EB"
    android:padding="24dp">

    <!-- Logo -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_travelshare_logo"
        android:contentDescription="TravelShare Logo"
        android:scaleType="fitCenter"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- App Name -->
    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TravelShare"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#1A73E8"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/ivLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Avatar -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/ivAvatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_default_avatar"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/tvAppName"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Menu -->
    <ImageButton
        android:id="@+id/btnMore"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_more"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivAvatar"/>

    <!-- Author (header post) -->
    <TextView
        android:id="@+id/tvAuthorName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Célia"
        android:textStyle="bold"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@id/ivAvatar"
        app:layout_constraintTop_toTopOf="@id/ivAvatar"
        app:layout_constraintEnd_toStartOf="@id/btnMore"/>

    <!-- Image Post -->
    <ImageView
        android:id="@+id/ivPhoto"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:scaleType="centerCrop"
        android:src="@drawable/placeholder_photo"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/ivAvatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Like -->
    <ImageButton
        android:id="@+id/btnLike"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_dislike"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/ivPhoto"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvLikeCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1k"
        android:layout_marginStart="6dp"
        app:layout_constraintStart_toEndOf="@id/btnLike"
        app:layout_constraintTop_toTopOf="@id/btnLike"
        app:layout_constraintBottom_toBottomOf="@id/btnLike"/>

    <ImageButton
        android:id="@+id/btnComment"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_comment"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toEndOf="@id/tvLikeCount"
        app:layout_constraintTop_toTopOf="@id/btnLike"/>

    <TextView
        android:id="@+id/tvCommentCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="45"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@id/btnComment"
        app:layout_constraintTop_toTopOf="@id/btnLike"/>

    <ImageButton
        android:id="@+id/btnShare"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_share"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toEndOf="@id/tvCommentCount"
        app:layout_constraintTop_toTopOf="@id/btnLike"/>

    <TextView
        android:id="@+id/tvShareCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="15"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@id/btnShare"
        app:layout_constraintTop_toTopOf="@id/btnLike"/>

    <ImageButton
        android:id="@+id/btnReport"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_signal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnLike"/>

    <!-- ⭐ POST AUTHOR + DESCRIPTION (CORRIGÉ) -->

    <TextView
        android:id="@+id/tvPostAuthor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Célia"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="#1A1A1A"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/btnLike"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvPostDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Découverte incroyable lors de mon voyage 🌍"
        android:textSize="13sp"
        android:textColor="#555555"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvPostAuthor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Likes text -->
    <TextView
        android:id="@+id/tvLikedBy"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Aimé par lina12 et d'autres personnes"
        android:textSize="13sp"
        android:textColor="#1A1A1A"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvPostDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGenerateRoute"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:text="Générer un parcours"
        android:textAllCaps="false"
        app:cornerRadius="20dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvLikedBy"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnOpenRoute"
        android:layout_marginEnd="8dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenRoute"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:text="Ouvrir itinéraire"
        android:textAllCaps="false"
        app:cornerRadius="20dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvLikedBy"
        app:layout_constraintStart_toEndOf="@id/btnGenerateRoute"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSimilarPhotos"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:text="Photos similaires"
        android:textAllCaps="false"
        app:cornerRadius="20dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnGenerateRoute"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Comments -->
    <TextView
        android:id="@+id/tvCommentsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Commentaires"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/btnSimilarPhotos"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvComment1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="jeremieJuk Très belle photo ❤️"
        android:textSize="13sp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/tvCommentsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>